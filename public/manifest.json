{
  "id": "com.moneymitra.app",
  "short_name": "Money Mitra",
  "name": "Money Mitra - Personal Finance App",
  "description": "Money Mitra - Free Offline Android Personal Finance Tracker with Room Database, Voice Logging, and Analytics.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#005cb2",
  "theme_color": "#005cb2",
  "categories": ["finance", "productivity", "utilities", "business"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.moneymitra.app",
      "url": "https://play.google.com/store/apps/details?id=com.moneymitra.app"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://ais-pre-zxzmmbfwhu3sfyrjfvjdya-583365474255.asia-east1.run.app"
    },
    {
      "origin": "https://ais-dev-zxzmmbfwhu3sfyrjfvjdya-583365474255.asia-east1.run.app"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "file_handlers": [
    {
      "action": "/?import=backup",
      "name": "Money Mitra Financial File",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+moneymitra",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/?shared=entry",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=add"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "widgets": [
    {
      "name": "Money Mitra Quick Balance",
      "description": "Check current balance and log quick transactions",
      "tag": "balance-widget",
      "template": "widget-template",
      "ms_ac_template": "/widget.json",
      "data": "/widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "1080x1920",
          "label": "Money Mitra Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Add",
      "description": "Record income or expense",
      "url": "/?action=add",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Transactions History",
      "short_name": "History",
      "description": "View monthly ledger",
      "url": "/?tab=transactions",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Money Mitra Mobile Finance Dashboard"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Money Mitra Desktop & Tablet Analytics"
    }
  ]
}
